{
  "type": "module",
  "private": true,
  "name": "@oh-my-pi/rust-maintainer-benchmark",
  "version": "0.0.1",
  "description": "Rust maintainer benchmark suite for OMP agents",
  "homepage": "https://omp.sh",
  "author": "Can Boluk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/rust-maintainer-benchmark"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  },
  "bin": {
    "rust-maintainer-benchmark": "src/index.ts"
  },
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "bun test --parallel",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "start": "bun run src/index.ts"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "catalog:",
    "@oh-my-pi/pi-ai": "catalog:",
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "@oh-my-pi/pi-tui": "catalog:",
    "@oh-my-pi/pi-utils": "catalog:",
    "diff": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
